{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Handbook",
  "version": "0.3.0",
  "identifier": "app.handbook.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Handbook",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Текстовый редактор, который пишет вашим почерком",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Kuparo",
    "category": "Productivity",
    "longDescription": "Локальный текстовый редактор: вы пишете варианты каждой буквы, а он пишет ваш текст вашим почерком.",
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
